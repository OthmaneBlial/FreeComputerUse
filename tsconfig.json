{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node"], "strict": true,
    "outDir": "dist", "rootDir": "src", "declaration": true,
    "sourceMap": true, "skipLibCheck": true, "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"]
}
