# Gemini's OpenAI-compatible endpoint, or another compatible provider.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# json_schema | json_object (for providers without schema support)
LLM_RESPONSE_FORMAT=json_schema
# Optional prices, USD per million tokens. Leave blank for unknown cost.
LLM_INPUT_PRICE=
LLM_OUTPUT_PRICE=
# Local state; browser cookies, profile, traces and workflows stay here.
FCU_DATA_DIR=.fcu
FCU_MAX_LLM_CALLS=10
FCU_MAX_INPUT_TOKENS=20000
FCU_MAX_OUTPUT_TOKENS=5000
