# Copy to .env (kept private, mode 0600) or store keys with `agent providers set-key <provider>`.
# Never commit a real key. Stored keys go to the macOS Keychain, or to a private file elsewhere.

# Default provider: anthropic | deepseek | openai | openai-compatible | claude-subscription | codex-subscription
LLM_PROVIDER=anthropic

# Claude API (https://console.anthropic.com). Default model: claude-opus-5-5.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional Claude effort: low | medium | high | xhigh | max
# LLM_EFFORT=medium

# DeepSeek API. Default model: deepseek-flash.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-pro

# OpenAI API. Set a model your account can use.
OPENAI_API_KEY=
# OPENAI_MODEL=

# Any other OpenAI-compatible endpoint: set LLM_PROVIDER=openai-compatible and these.
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=
# LLM_API_KEY=
# json_object | json_schema
# LLM_RESPONSE_FORMAT=json_object
# max_tokens | max_completion_tokens (defaults to max_completion_tokens for api.openai.com)
# LLM_MAX_OUTPUT_TOKENS_PARAM=max_tokens

# Claude Pro/Max through Claude Code 2.1.310+: run `claude auth login`, then LLM_PROVIDER=claude-subscription.
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_CLI_PATH=/usr/local/bin/claude
# ChatGPT plan through Codex CLI: run `codex login`, then LLM_PROVIDER=codex-subscription.
# CODEX_MODEL=
# CODEX_CLI_PATH=/usr/local/bin/codex
# How long a Claude Code or Codex CLI call may take, in ms (default 60000). A busy
# ChatGPT plan can hold a Codex call for minutes; 300000 lets it finish.
# FCU_CLI_TIMEOUT_MS=300000

# Optional: try these providers in order when the default one fails.
# LLM_FALLBACK_PROVIDERS=deepseek,anthropic
# Optional: move repairs to a stronger model after two repairs in one task.
# LLM_ESCALATION_MODEL=deepseek-v4-pro
# LLM_ESCALATION_PROVIDER=deepseek

# Optional prices for the default provider, USD per million tokens. Leave blank for unknown cost.
LLM_INPUT_PRICE=
LLM_OUTPUT_PRICE=
LLM_CACHED_INPUT_PRICE=

# Optional: use an installed Chrome or Edge instead of Playwright's bundled Chromium.
# FCU_BROWSER_CHANNEL=chrome

# Local state: browser cookies, profile, traces, procedures and stored keys (file store) stay here.
FCU_DATA_DIR=.fcu
# Key store: keychain (default on macOS) | file
# FCU_SECRET_STORE=file

# Optional vision fallback: the third and later repairs in a task send a viewport screenshot with form
# fields masked, for providers whose model accepts images (Claude API, deepseek-flash, OpenAI).
# FCU_VISION=1

# Optional limits for one task. Unset means no cap except 120 browser actions.
# FCU_MAX_LLM_CALLS=100
# FCU_MAX_INPUT_TOKENS=250000
# FCU_MAX_OUTPUT_TOKENS=30000
# FCU_MAX_STEPS=120
# FCU_MAX_DURATION_MS=600000
